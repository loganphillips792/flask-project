{
  "uid": "library-app",
  "title": "Library App",
  "description": "Metrics, traces and logs for the Flask library API.",
  "tags": ["library", "flask"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Up",
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green", "index": 1 } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "up{job=\"flask-app\"}",
          "legendFormat": "up",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error rate (5xx)",
      "description": "Share of requests returning 5xx over the last 5 minutes.",
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "100 * (sum(rate(flask_http_request_total{job=\"flask-app\",status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(flask_http_request_total{job=\"flask-app\"}[5m])), 1)",
          "legendFormat": "5xx %",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Unhandled exceptions",
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.001 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(rate(flask_http_request_exceptions_total{job=\"flask-app\"}[5m])) or vector(0)",
          "legendFormat": "exceptions/s",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Request rate by status",
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum by (status) (rate(flask_http_request_total{job=\"flask-app\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "p95 latency by endpoint",
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(flask_http_request_duration_seconds_bucket{job=\"flask-app\"}[5m])))",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Hits by endpoint",
      "description": "Server spans over the selected range, from Tempo span metrics (dimensions set in tempo.yaml). URL is the Flask route rule, not the raw path.",
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [{ "displayName": "Calls", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Calls" },
            "properties": [{ "id": "unit", "value": "short" }, { "id": "decimals", "value": 0 }]
          },
          {
            "matcher": { "id": "byName", "options": "Avg Duration" },
            "properties": [{ "id": "unit", "value": "s" }, { "id": "decimals", "value": 1 }]
          }
        ]
      },
      "targets": [
        {
          "refId": "calls",
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "round(sum by (http_route, http_method, http_status_code, http_scheme) (increase(traces_spanmetrics_calls_total{service=\"flask-app\",span_kind=\"SPAN_KIND_SERVER\"}[$__range]))) > 0",
          "format": "table",
          "instant": true
        },
        {
          "refId": "avg",
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum by (http_route, http_method, http_status_code, http_scheme) (increase(traces_spanmetrics_latency_sum{service=\"flask-app\",span_kind=\"SPAN_KIND_SERVER\"}[$__range])) / sum by (http_route, http_method, http_status_code, http_scheme) (increase(traces_spanmetrics_latency_count{service=\"flask-app\",span_kind=\"SPAN_KIND_SERVER\"}[$__range])) > 0",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": {
              "http_route": 0,
              "http_method": 1,
              "http_status_code": 2,
              "http_scheme": 3,
              "Value #calls": 4,
              "Value #avg": 5
            },
            "renameByName": {
              "http_route": "URL",
              "http_method": "Method",
              "http_status_code": "Status",
              "http_scheme": "Scheme",
              "Value #calls": "Calls",
              "Value #avg": "Avg Duration"
            }
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Status codes",
      "description": "Responses per status code, counted per bar interval (at least 1m, so each bucket spans several scrapes). Stacked, coloured by class.",
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "interval": "1m",
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "^2\\d\\d$" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^3\\d\\d$" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^4\\d\\d$" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^5\\d\\d$" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "round(sum by (status) (increase(flask_http_request_total{job=\"flask-app\"}[$__interval])))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Span rate by name (from Tempo span metrics)",
      "description": "Generated by Tempo's metrics_generator and remote-written into Prometheus.",
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"flask-app\"}[5m]))",
          "legendFormat": "{{span_name}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Application logs",
      "description": "Selects on service_name, the compose service label. Docker's own container names carry a leading slash.",
      "datasource": { "type": "loki", "uid": "loki_ds" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 36 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki_ds" },
          "expr": "{service_name=\"flask-app\"} | json | logger!=\"app.db\"",
          "queryType": "range"
        }
      ]
    }
  ]
}
